{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": false,
		"paths": { "$lib/*": ["../src/lib/*"] }
	},
	"include": ["./**/*.ts", "../playwright.config.ts"]
}
